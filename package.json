{
  "name": "@note-app/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "api:serve": "nx serve api",
    "api:serve:prod": "nx serve api --configuration=production",
    "api:build": "nx build api",
    "api:build:prod": "nx build api --configuration=production",
    "api:test": "nx test api",
    "api:test:watch": "nx test api --watch",
    "api:lint": "nx lint api",
    "api:e2e": "nx e2e api-e2e",
    "api:graph": "nx graph --focus=api",
    "api:reset": "nx reset",
    "api:affected": "nx affected --target=build --projects=api",
    "prepare": "husky",
    "commit": "cz",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "lint:commit": "commitlint --from=HEAD~1 --to=HEAD"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.6.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/docker": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "nx": "23.1.0",
    "prettier": "~3.6.2",
    "standard-version": "^9.5.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
