{
  "name": "@note-app/source",
  "version": "1.1.0",
  "license": "MIT",
  "scripts": {
    "api:serve": "nx serve api",
    "api:serve:prod": "nx serve api --configuration=production",
    "api:build": "nx build api",
    "api:build:prod": "nx build api --configuration=production",
    "api:test": "nx test api",
    "api:test:watch": "nx test api --watch",
    "api:lint": "nx lint api",
    "api:e2e": "nx e2e api-e2e",
    "api:graph": "nx graph --focus=api",
    "web:serve": "nx serve web",
    "web:serve:prod": "nx serve web --configuration=production",
    "web:build": "nx build web",
    "web:build:prod": "nx build web --configuration=production",
    "web:test": "nx test web",
    "web:test:watch": "nx test web --watch",
    "web:lint": "nx lint web",
    "web:e2e": "nx e2e web-e2e",
    "web:graph": "nx graph --focus=web",
    "serve": "nx run-many -t serve -p api web --parallel",
    "build": "nx run-many -t build -p api web --parallel",
    "build:prod": "nx run-many -t build -p api web --configuration=production --parallel",
    "test": "nx run-many -t test -p api web --parallel",
    "lint": "nx run-many -t lint -p api web --parallel",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:logs:api": "docker compose logs -f api",
    "docker:logs:web": "docker compose logs -f web",
    "docker:ps": "docker compose ps",
    "docker:pull": "docker compose pull",
    "docker:rebuild": "docker compose build --no-cache",
    "docker:up:build": "docker compose up -d --build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "prepare": "husky",
    "commit": "cz",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "lint:commit": "commitlint --from=HEAD~1 --to=HEAD",
    "nx:reset": "nx reset"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.6.0",
    "body-parser": "^2.3.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "6.30.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/docker": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/react": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^5.6.22",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "nx": "23.1.0",
    "prettier": "~3.6.2",
    "standard-version": "^9.5.0",
    "swagger-typescript-api": "^13.12.6",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
